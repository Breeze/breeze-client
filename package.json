{
  "name": "breeze-client",
  "version": "2.2.2",
  "private": true,
  "description": "Breeze data management for JavaScript clients",
  "repository": "https://github.com/Breeze/breeze-client.git",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/eslint-plugin-tslint": "^6.15.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.57.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.0",
    "downlevel-dts": "^0.11.0"
  },
  "scripts": {
    "clean": "rimraf temp && rimraf src/*.js* && rimraf src/*.d.ts && rimraf ./*.d.ts && rimraf dist && rimraf node_modules/breeze-client.js",
    "lint": "eslint -c .eslintrc.js --ext .ts src",
    "tsc": "tsc",
    "watch-tsc": "tsc -w",
    "typedoc": "typedoc --out ./temp/docs/ --excludePrivate --readme ./readme.doc.md ./src/breeze.ts && node tools/copyIfDifferent.js temp/docs docs "
  },
  "author": {
    "name": "IdeaBlade",
    "email": "jayt@ideablade.com",
    "url": "https://www.ideablade.com/"
  },
  "contributors": [
    "Jay Traband",
    "Steve Schmitt",
    "Marcel Good",
    "Ward Bell"
  ],
  "keywords": [
    "breeze",
    "breezejs",
    "spa",
    "data binding",
    "change tracking",
    "query",
    "linq",
    "cache",
    "graph",
    "graphql",
    "angular",
    "angularjs",
    "react",
    "vue",
    "aurelia",
    "relational",
    "orm",
    "entity",
    "model"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Breeze/breeze-client/issues"
  },
  "homepage": "https://github.com/Breeze/breeze-client#readme"
}
